# Netshoot zshrc, installed as $ZDOTDIR/.zshrc (ZDOTDIR=/etc/zsh/netshoot).
# It must work for root (HOME=/root) and for any uid without a passwd entry
# (docker run --user 1000:1000, where HOME=/ is not writable).

# A user-provided ~/.zshrc (e.g. bind-mounted) replaces this file entirely.
# The guard variable lets that file source this one back to extend it instead.
if [[ -z "$_NETSHOOT_USER_ZSHRC" && -f "$HOME/.zshrc" && ! "$HOME/.zshrc" -ef "${(%):-%x}" ]]; then
  _NETSHOOT_USER_ZSHRC=1
  source "$HOME/.zshrc"
  return
fi

ZSH_DISABLE_COMPFIX=true

# Pick a writable cache directory: $XDG_CACHE_HOME or ~/.cache when usable,
# otherwise a private per-uid directory under $TMPDIR (/tmp). XDG_CACHE_HOME is
# only exported in the fallback case, so that Powerlevel10k and other tools
# follow it. This must stay above the instant prompt block.
if [[ -n "$XDG_CACHE_HOME" ]] && mkdir -p -- "$XDG_CACHE_HOME" 2>/dev/null && [[ -w "$XDG_CACHE_HOME" ]]; then
  _netshoot_cache="$XDG_CACHE_HOME"
elif mkdir -p -- "$HOME/.cache" 2>/dev/null && [[ -w "$HOME/.cache" ]]; then
  _netshoot_cache="$HOME/.cache"
else
  _netshoot_cache="${TMPDIR:-/tmp}/netshoot-$UID"
  mkdir -p -m 700 -- "$_netshoot_cache" 2>/dev/null
  # Never use a directory another uid created (or could write to) in /tmp.
  if [[ ! -d "$_netshoot_cache" || ! -O "$_netshoot_cache" || ! -w "$_netshoot_cache" ]]; then
    _netshoot_cache="$(mktemp -d "${TMPDIR:-/tmp}/netshoot-$UID.XXXXXX")"
  fi
  export XDG_CACHE_HOME="$_netshoot_cache"
  # Tools such as thefuck insist on creating ~/.config: give them a place too.
  if [[ -z "$XDG_CONFIG_HOME" && ! -w "$HOME/.config" ]]; then
    export XDG_CONFIG_HOME="$_netshoot_cache/config"
    mkdir -p -- "$XDG_CONFIG_HOME"
  fi
fi
ZSH_COMPDUMP="$_netshoot_cache/zsh/zcompdump"
ZSH_CACHE_DIR="$_netshoot_cache/oh-my-zsh"
mkdir -p -- "$_netshoot_cache/zsh" "$ZSH_CACHE_DIR/completions"

# History: keep a HISTFILE set by the caller (docker run -e HISTFILE=...),
# otherwise ~/.zsh_history when it can be written, else the cache directory.
if [[ -z "$HISTFILE" ]]; then
  if [[ -w "$HOME" || -w "$HOME/.zsh_history" ]]; then
    HISTFILE="$HOME/.zsh_history"
  else
    HISTFILE="$_netshoot_cache/zsh/zsh_history"
  fi
fi

[[ -n "$ZSH_PROF" ]] && zmodload zsh/zprof

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- ENVIRONMENT VARIABLES ---

export EDITOR='vim'
export GPG_TTY=$(tty)

# --- PATH CONFIGURATION ---
typeset -U path
# Skipped when HOME=/ (uid without passwd entry): it would only add //bin.
if [[ "$HOME" != "/" ]]; then
  path=(
    "$HOME/bin"
    "$HOME/.local/bin"
    $path
  )
fi

# --- FPATH CONFIGURATION ---
typeset -U fpath
fpath=(
  "$HOME/.docker/completions"
  "$HOME/.zsh_completions"
  $fpath
)

# --- OH-MY-ZSH CONFIGURATION ---
# Oh My Zsh is installed system-wide (read-only for non-root users).
export ZSH=/opt/oh-my-zsh
ZSH_CUSTOM="$ZSH/custom"
ZSH_THEME="powerlevel10k/powerlevel10k"

# The installation is pinned at build time: never try to update it at runtime.
zstyle ':omz:update' mode disabled

# The bundled .p10k.zsh is always loaded, so the wizard is never needed.
POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true

plugins=(
  git
  command-not-found
  zsh-autosuggestions
  colored-man-pages
  zsh-completions
  fast-syntax-highlighting
  extract
)

# fzf plugin requires the binary (not installed in the slim image) and the line
# editor: without a tty on stdin (zsh -ic ...), its key bindings error out.
command -v fzf >/dev/null 2>&1 && [[ -t 0 ]] && plugins+=(fzf)

# thefuck plugin requires the binary to be installed
command -v thefuck >/dev/null 2>&1 && plugins+=(thefuck)

# kubectl/helm plugins only if the binaries are available
command -v kubectl >/dev/null 2>&1 && plugins+=(kubectl)
command -v helm >/dev/null 2>&1 && plugins+=(helm)

# OMZ settings must be set before sourcing oh-my-zsh.
HIST_STAMPS="dd/mm/yyyy"
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_AUTO_TITLE="true"
ENABLE_CORRECTION="false"
COMPLETION_WAITING_DOTS_CUSTOM="true"

# Load local and secret configurations if they exist.
# NOTE: .zshrc.local uses `plugins+=()` to add plugins. This works because it is
# sourced after the `plugins` array is defined and before oh-my-zsh reads it.
# It can also override any of the settings above. Keep this order.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
[[ -f "$HOME/.zshrc.secrets" ]] && source "$HOME/.zshrc.secrets"

source "$ZSH/oh-my-zsh.sh"

# --- GENERAL SETTINGS & OPTIONS ---

# Disable vim's mouse capture
export VIMINIT='set mouse='

# Disable globbing for specific commands to avoid issues with special characters
alias find="noglob find"
alias curl="noglob curl"
alias wget="noglob wget"
alias uv="noglob uv"
alias pip="noglob pip"

# --- ALIASES AND FUNCTIONS ---

# --- Container Tools (Docker, Nerdctl, Podman) ---
# Detect the available container runtime and set aliases accordingly.
_container_runtime=""
if command -v docker >/dev/null 2>&1; then
  _container_runtime="docker"
elif command -v nerdctl >/dev/null 2>&1; then
  _container_runtime="nerdctl"
elif command -v podman >/dev/null 2>&1; then
  _container_runtime="podman"
fi

if [[ -n "$_container_runtime" ]]; then
  alias d="$_container_runtime"
  alias dc="$_container_runtime compose"
  alias drit="$_container_runtime run -ti --rm"
  alias diel="$_container_runtime exec -it \$($_container_runtime ps -ql)"

  # Set `docker` alias if using an alternative runtime
  if [[ "$_container_runtime" != "docker" ]]; then
    alias docker="$_container_runtime"
  fi

  # Wrapper for logs that defaults to --tail 100 when no -n/--lines flag is given
  container_logs_with_default() {
    local -a args
    args=("$@")
    if [[ ! " ${args[@]} " =~ " -n " && ! " ${args[@]} " =~ " --lines " ]]; then
      args+=("-n" "100")
    fi
    "$_container_runtime" logs "${args[@]}"
  }
  alias dl="container_logs_with_default"
  compdef "_${_container_runtime}" dl
fi


# --- Python Virtual Environments ---

# Creates and activates a Python virtual environment using python3's venv module.
# Installs dependencies from requirements.txt and pyproject.toml if they exist.
pyenv() {
  if [[ ! -d .venv ]]; then
    python3 -m venv .venv || { echo "Failed to create virtual environment." >&2; return 1; }
  fi
  source .venv/bin/activate
  [[ -f requirements.txt ]] && pip install -Ur requirements.txt
  [[ -f pyproject.toml  ]] && pip install -e .
}

# Uses `uv` for a faster venv setup and package installation.
uvenv() {
  if [[ -f uv.lock ]]; then
    uv sync || { echo "Failed to sync with uv." >&2; return 1; }
    source .venv/bin/activate
    return 0
  fi
  if [[ ! -d .venv ]]; then
    uv venv || { echo "Failed to create virtual environment with uv." >&2; return 1; }
  fi
  source .venv/bin/activate
  [[ ! -f .venv/bin/pip ]] && uv pip install pip
  [[ -f requirements.txt ]] && uv pip install -Ur requirements.txt
  [[ -f pyproject.toml  ]] && uv pip install -e .
}

# Creates a temporary virtual environment in a disposable directory.
pyenv_tmp() {
  local tmp_dir
  tmp_dir=$(mktemp -d)
  cd "$tmp_dir" || return 1
  echo "Created temporary environment in: $tmp_dir"
  python3 -m venv .venv
  source .venv/bin/activate
  [[ -f requirements.txt ]] && pip install -r requirements.txt
}


# --- Miscellaneous Aliases & Functions ---
alias sk='ssh-keygen -R'
alias gcl1='git clone --depth 1'
alias tmp='mkdir -p ~/tmp && cd ~/tmp'
alias igrep='grep -i'

# Restart a systemd service and follow its logs
# sudo is only used when not already root (and only if it is installed).
if command -v systemctl >/dev/null 2>&1; then
  sjs() {
    local -a _sudo
    (( EUID != 0 )) && command -v sudo >/dev/null 2>&1 && _sudo=(sudo)
    "${_sudo[@]}" systemctl restart "$1" &
    "${_sudo[@]}" journalctl -fu "$1"
  }
  compdef _systemctl sjs
fi


# --- FINALIZATION ---

# Ignore bracketed paste for autosuggestions to prevent issues
ZSH_AUTOSUGGEST_IGNORE_WIDGETS+=(bracketed-paste)

# Load Powerlevel10k prompt: the user's ~/.p10k.zsh if present, else the bundled one.
if [[ -f "$HOME/.p10k.zsh" ]]; then
  source "$HOME/.p10k.zsh"
else
  source "${ZDOTDIR:-/etc/zsh/netshoot}/.p10k.zsh"
fi
