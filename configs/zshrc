# Function to restart a systemd service and follow its logs.
sjs() {
  sudo systemctl restart "$1" &
  sudo journalctl -fu "$1"
}
compdef _systemctl sjs

# Fallback for `sgpt` using a Docker container if not installed locally.
if ! command -v sgpt >/dev/null 2>&1; then
  sgpt() {
    docker run --rm -ti \
      --env OPENAI_API_KEY="$OPENAI_API_KEY" \
      --env OS_NAME="$(uname -s)" \
      --env SHELL_NAME="$(basename "$SHELL")" \
      --env DEFAULT_MODEL="gpt-4o" \
      --volume gpt-cache:/tmp/shell_gpt \
      -v "$PWD:$PWD" \
      -v "$HOME/.config/shell_gpt:/root/.config/shell_gpt/" \
      --workdir "$PWD" \
      ghcr.io/ther1d/shell_gpt "$@"
  }
fi

# --- SHELL INTEGRATIONS ---
# Atuin for shell history
# This logic allows toggling history recording via `histoff` and `histon`.
if [[ -z "$HIST_IGNORE_ALL" ]]; then
  if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh --disable-up-arrow)"
    export ZSH_AUTOSUGGEST_STRATEGY=(atuin completion)
  fi
  alias histoff='env HIST_IGNORE_ALL=true zsh'
else
  export HISTFILE=/dev/null
  alias histon='exit'
fi

# --- AI Shell Integrations ---
# Helper function to prepare the ZLE buffer for an AI command.
# This avoids code duplication between _sgpt_zsh and _aichat_zsh.
# It prints the prompt, adds a waiting symbol, and returns the original prompt.
_ai_zle_prepare() {
  local _old_buffer=$BUFFER
  print -P "\e[90m# $_old_buffer\e[0m" # Print command in gray
  BUFFER+="⌛"
  zle -I && zle redisplay
  echo "$_old_buffer"
}

# Shell-GPT integration ZSH v0.2
_sgpt_zsh() {
  if [[ -n "$BUFFER" ]]; then
    local _prompt=$(_ai_zle_prepare)
    BUFFER=$(sgpt --shell <<< "$_prompt" --no-interaction)
    zle end-of-line
  fi
}
zle -N _sgpt_zsh
bindkey ^l _sgpt_zsh


# AiChat integration (Alt+E or Esc then E)
_aichat_zsh() {
  if [[ -n "$BUFFER" ]]; then
    local _prompt=$(_ai_zle_prepare)
    BUFFER=$(aichat -r shell_assistant -c "$_prompt" 2>>/tmp/aichat_debug.log)
    zle end-of-line
  fi
}
zle -N _aichat_zsh
bindkey '\ee' _aichat_zsh

