# For Cline VScode extension
[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh)"

ZSH_DISABLE_COMPFIX=true
ZSH_COMPDUMP="$HOME/.cache/zsh/zcompdump"
mkdir -p "$HOME/.cache/zsh"

# Personal ZSH configuration file.
[[ -n "$ZSH_PROF" ]] && zmodload zsh/zprof

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Load local and secret configurations if they exist.
# NOTE: .zshrc.local uses `plugins+=()` to add plugins. This works because
# oh-my-zsh reads the `plugins` array later at source time. Keep this order.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
[[ -f "$HOME/.zshrc.secrets" ]] && source "$HOME/.zshrc.secrets"

# --- ENVIRONMENT VARIABLES ---
# Shell GPT
export OTEL_SDK_DISABLED="true"

# Telemetry disabling for various tools
export DISABLE_TELEMETRY="true"
export OLLAMA_NOHISTORY="true"

# Enable Claude Code auto-memory (double-negative: DISABLE=0 → enabled)
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=0

# Node.js options to handle punycode deprecation warnings (e.g., from bw)
export NODE_OPTIONS="--no-deprecation"

# Enable fast bytecode compilation for uv
export UV_COMPILE_BYTECODE=1

# Enable huggingface fast transfer
export HF_HUB_ENABLE_HF_TRANSFER=1

# Set editor
export EDITOR='vim'

# --- PATH CONFIGURATION ---
# Zsh provides a `path` array that automatically stays in sync with PATH.
# `typeset -U` ensures that all elements are unique, preventing duplicates.
typeset -U path
path=(
  "$HOME/bin"
  "$HOME/.local/bin"
  "${KREW_ROOT:-$HOME/.krew}/bin"
  "$HOME/.local/go_workspace/bin"
  "$HOME/.lando/bin" # Lando path
  "$HOME/.cache/lm-studio/bin" # LM Studio CLI
  $path
)

# --- FPATH CONFIGURATION ---
# Zsh provides `fpath` for function autoloading paths.
# `typeset -U` ensures uniqueness.
typeset -U fpath
fpath=(
  "$HOME/.docker/completions"
  "$HOME/.zsh_completions"
  $fpath
)


# --- OH-MY-ZSH CONFIGURATION ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  kubectl
  command-not-found
  helm
  zsh-autosuggestions
  brew
  colored-man-pages
  zsh-completions
  fast-syntax-highlighting
  fzf
  extract
  thefuck
)

# Add bgnotify plugin if on macOS or DBUS is available
if [[ "$OSTYPE" == darwin* || -n "$DBUS_SESSION_BUS_ADDRESS" ]]; then
  plugins+=(bgnotify)
fi

# OMZ settings must be set before sourcing oh-my-zsh.
HIST_STAMPS="dd/mm/yyyy"
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_AUTO_TITLE="true"
ENABLE_CORRECTION="false"
COMPLETION_WAITING_DOTS_CUSTOM="true"

source "$ZSH/oh-my-zsh.sh"

# --- GENERAL SETTINGS & OPTIONS ---

# Disable vim's mouse capture
export VIMINIT='set mouse='

# Disable globbing for specific commands to avoid issues with special characters
alias find="noglob gfind"
alias curl="noglob curl"
alias uv="noglob uv"
alias pip="noglob pip"

# --- ALIASES AND FUNCTIONS ---

# --- Container Tools (Docker, Nerdctl, Podman) ---
# Detect the available container runtime and set aliases accordingly.
# This approach avoids code duplication.
_container_runtime=""
if command -v docker &>/dev/null; then
  _container_runtime="docker"
elif command -v nerdctl &>/dev/null; then
  _container_runtime="nerdctl"
elif command -v podman &>/dev/null; then
  _container_runtime="podman"
fi

if [[ -n "$_container_runtime" ]]; then
  # Generic aliases
  alias d="$_container_runtime"
  alias dc="$_container_runtime compose"
  alias ds="$_container_runtime sandbox"
  alias drit="$_container_runtime run -ti --rm"
  alias diel="$_container_runtime exec -it \$($_container_runtime ps -ql)"

  # Set `docker` alias if using an alternative
  if [[ "$_container_runtime" != "docker" ]]; then
    alias docker="$_container_runtime"
  fi

  # Function to get logs with a default line count
  container_logs_with_default() {
    local -a args
    args=("$@")
    # Check if -n or --lines is already present
    if [[ ! " ${args[@]} " =~ " -n " && ! " ${args[@]} " =~ " --lines " ]]; then
      args+=("-n" "100")
    fi
    "$_container_runtime" logs "${args[@]}"
  }
  alias dl="container_logs_with_default"

  # Setup completion for the 'dl' alias
  compdef "_${_container_runtime}" dl
fi


# --- Python Virtual Environments ---
# The complex aliases for setting up Python environments have been
# converted into functions for better readability and maintainability.

# Creates and activates a Python virtual environment using python3's venv module.
# Installs dependencies from requirements.txt and pyproject.toml if they exist.
pyenv() {
  # Create virtual environment if it doesn't exist
  if [[ ! -d .venv ]]; then
    python3 -m venv .venv
    if [[ $? -ne 0 ]]; then
      echo "Failed to create virtual environment with python3-venv." >&2
      return 1
    fi
  fi

  # Activate the environment
  source .venv/bin/activate

  # Install dependencies from requirements.txt if it exists
  if [[ -f requirements.txt ]]; then
    pip install -Ur requirements.txt
  fi

  # Install the project in editable mode if pyproject.toml exists
  if [[ -f pyproject.toml ]]; then
    pip install -e .
  fi
}

# Uses `uv` for a faster venv setup and package installation.
uvenv() {
  # Create virtual environment if it doesn't exist
  if [[ ! -d .venv ]]; then
    uv venv
    if [[ $? -ne 0 ]]; then
      echo "Failed to create virtual environment with uv." >&2
      return 1
    fi
  fi

  # Activate the environment
  source .venv/bin/activate

  # Ensure pip is installed for compatibility
  if [[ ! -f .venv/bin/pip ]]; then
    uv pip install pip
  fi

  # Install dependencies from requirements.txt if it exists
  if [[ -f requirements.txt ]]; then
    uv pip install -Ur requirements.txt
  fi

  # Install the project in editable mode if pyproject.toml exists
  if [[ -f pyproject.toml ]]; then
    uv pip install -e .
  fi
}

# Creates a temporary virtual environment in a new directory.
pyenv_tmp() {
  local tmp_dir
  tmp_dir=$(mktemp -d)
  cd "$tmp_dir" || return 1
  echo "Created temporary environment in: $tmp_dir"
  python3 -m venv .venv
  source .venv/bin/activate
  if [[ -f requirements.txt ]]; then
    pip install -r requirements.txt
  fi
}


# --- GNU Core Utilities on macOS ---
# If enabled, it aliases standard commands to their GNU counterparts if installed (e.g., ls -> gls).
if [[ "$OSTYPE" == "darwin"* ]]; then
  gnu_utils=(
    readlink date df dir dircolors vdir false ln mkdir mknod mkfifo
    nice pathchk pinky printenv pwd rmdir sleep stat sync touch true
    uname chgrp chmod chown install nl od paste ptx pr sum tac tail tr
    base32 base64 cut split csplit wc uniq comm shuf tee head join sort factor
    seq timeout env groups id whoami du who w users find
  )

  for util in "${gnu_utils[@]}"; do
    if command -v "g${util}" >/dev/null 2>&1; then
      alias "${util}=g${util}"
    fi
  done
  # ls gets special treatment with extra flags
  if command -v gls >/dev/null 2>&1; then
    alias ls="gls --hyperlink=auto --color=tty"
  fi
fi

